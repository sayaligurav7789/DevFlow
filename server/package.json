{
  "name": "devflow-server",
  "version": "0.1.0",
  "private": true,
  "description": "DevFlow Express API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
