# Server runtime
NODE_ENV=development
PORT=5000

# Origin allowed by CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Provide SESSION_SECRET or set a strong local value here.
SESSION_SECRET=

# PostgreSQL connection used by the backend and docker-compose.yml
DEVFLOW_DB_HOST=127.0.0.1
DEVFLOW_DB_PORT=5432
DEVFLOW_DB_NAME=devflow
DEVFLOW_DB_USER=devflow
DEVFLOW_DB_PASSWORD=

# Redis is exposed only on the local machine by docker-compose.yml
DEVFLOW_REDIS_PORT=6379
# Optional overrides (DEVFLOW_REDIS_URL wins over host/port/password):
# DEVFLOW_REDIS_URL=redis://127.0.0.1:6379
# DEVFLOW_REDIS_HOST=127.0.0.1
# DEVFLOW_REDIS_PASSWORD=
# DEVFLOW_REDIS_ENABLED=true            # false = never connect; everything uses PostgreSQL only
# DEVFLOW_REDIS_COMMAND_TIMEOUT_MS=300  # per-command timeout before falling back to PostgreSQL

# Dashboard cache lifetime in seconds (invalidated sooner by any project/task change)
# DEVFLOW_DASHBOARD_CACHE_TTL_SECONDS=60

# Set to the number of reverse proxies in front of the API (1 behind one load balancer) so rate
# limits see the real client IP. Leave 0 when clients connect directly.
# DEVFLOW_TRUST_PROXY=0
# Multiplies every rate limit (e.g. 100 while running the e2e suite). Default 1.
# DEVFLOW_RATE_LIMIT_SCALE=1

# Deadline notifications (every API process runs the idempotent sweep)
# DEVFLOW_DEADLINE_SWEEP_ENABLED=true
# DEVFLOW_DEADLINE_SWEEP_INTERVAL_MS=900000
# DEVFLOW_DUE_SOON_WINDOW_HOURS=24

# Optional values for the local seed data
DEVFLOW_SEED_EMAIL=devflow-seed@local.test
DEVFLOW_SEED_NAME=DevFlow Local Seed

# --- Docker (docker-compose.yml, profile "app") ---------------------------------------------------
# Host port the containerised API is published on (bound to 127.0.0.1 only).
# DEVFLOW_API_PORT=5000
# Environment the API container runs as. "production" (default) sets Secure cookies and hides error
# details; use "development" to try the containerised API over plain http locally with invitation
# links shown on screen.
# DEVFLOW_APP_ENV=production
